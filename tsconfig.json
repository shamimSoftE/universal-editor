{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "strict": true,
    "strictNullChecks": true,
    "strictFunctionTypes": true,
    "noImplicitAny": true,
    "noImplicitThis": true,
    "alwaysStrict": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "noImplicitReturns": true,
    "noFallthroughCasesInSwitch": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true,
    "resolveJsonModule": true,
    "declaration": true,
    "declarationMap": true,
    "sourceMap": true,
    "baseUrl": ".",
    "paths": {
      "@universal-editor/core": ["packages/core/src/index.ts"],
      "@universal-editor/utils": ["packages/utils/src/index.ts"],
      "@universal-editor/extensions": ["packages/extensions/src/index.ts"],
      "@universal-editor/vue3": ["packages/vue3/src/index.ts"],
      "@universal-editor/vue2": ["packages/vue2/src/index.ts"]
    }
  },
  "include": [
    "packages/*/src/**/*",
    "demo/src/**/*",
    "tests/**/*"
  ],
  "exclude": [
    "node_modules",
    "**/dist",
    "laravel"
  ]
}
