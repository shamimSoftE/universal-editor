{
  "name": "vendor/laravel-universal-editor",
  "version": "1.0.0",
  "description": "Laravel integration package for Universal Rich Text Editor",
  "keywords": [
    "laravel",
    "rich-text-editor",
    "tiptap",
    "prosemirror",
    "wysiwyg",
    "cms"
  ],
  "type": "library",
  "license": "MIT",
  "authors": [
    {
      "name": "Enterprise Architecture Team"
    }
  ],
  "require": {
    "php": "^8.1|^8.2|^8.3",
    "illuminate/support": "^10.0|^11.0"
  },
  "autoload": {
    "psr-4": {
      "UniversalEditor\\Laravel\\": "src/"
    }
  },
  "extra": {
    "laravel": {
      "providers": [
        "UniversalEditor\\Laravel\\EditorServiceProvider"
      ],
      "aliases": {
        "Editor": "UniversalEditor\\Laravel\\Facades\\Editor"
      }
    }
  }
}
