{
  "name": "@shamimsofte/universal-editor-extensions",
  "version": "1.0.1",
  "type": "module",
  "description": "Custom and extended extensions for Universal Editor",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    }
  },
  "files": [
    "dist",
    "README.md"
  ],
  "repository": {
    "type": "git",
    "url": "https://github.com/shamimSoftE/universal-editor.git",
    "directory": "packages/extensions"
  },
  "homepage": "https://github.com/shamimSoftE/universal-editor#readme",
  "sideEffects": false,
  "keywords": [
    "rich-text-editor",
    "extensions",
    "tiptap",
    "prosemirror",
    "wysiwyg"
  ],
  "author": "shamimSoftE",
  "license": "MIT",
  "scripts": {
    "build": "vite build",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@tiptap/core": "^2.2.4",
    "@shamimsofte/universal-editor-core": "^1.0.1"
  },
  "devDependencies": {
    "typescript": "^5.4.2"
  }
}
