{
  "name": "@shamimsofte/universal-editor-vue2",
  "version": "1.0.1",
  "type": "module",
  "description": "Vue 2 adapter for Universal Rich Text Editor (Vue 2.6+ & 2.7)",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    }
  },
  "files": [
    "dist",
    "README.md"
  ],
  "repository": {
    "type": "git",
    "url": "https://github.com/shamimSoftE/universal-editor.git",
    "directory": "packages/vue2"
  },
  "homepage": "https://github.com/shamimSoftE/universal-editor#readme",
  "sideEffects": false,
  "keywords": [
    "rich-text-editor",
    "vue2",
    "tiptap",
    "prosemirror",
    "wysiwyg"
  ],
  "author": "shamimSoftE",
  "license": "MIT",
  "scripts": {
    "build": "vite build",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@shamimsofte/universal-editor-core": "^1.0.1"
  },
  "peerDependencies": {
    "vue": "^2.6.0 || ^2.7.0"
  },
  "peerDependenciesMeta": {
    "vue": {
      "optional": true
    }
  }
}
