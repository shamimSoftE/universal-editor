{
  "name": "@universal-editor/vue2",
  "version": "1.0.0",
  "type": "module",
  "description": "Vue 2 adapter for Universal Rich Text Editor (Vue 2.6+ & 2.7)",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    }
  },
  "files": [
    "dist"
  ],
  "sideEffects": false,
  "keywords": [
    "rich-text-editor",
    "vue2",
    "tiptap",
    "prosemirror",
    "wysiwyg"
  ],
  "author": "Enterprise Architecture Team",
  "license": "MIT",
  "scripts": {
    "build": "vite build",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@universal-editor/core": "^1.0.0"
  },
  "peerDependencies": {
    "vue": "^2.6.0 || ^2.7.0"
  },
  "peerDependenciesMeta": {
    "vue": {
      "optional": true
    }
  }
}
