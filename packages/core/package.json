{
  "name": "@shamimsofte/universal-editor-core",
  "version": "1.0.1",
  "type": "module",
  "description": "Framework-independent core engine for Universal Editor",
  "main": "./dist/universal-editor.umd.js",
  "module": "./dist/universal-editor.es.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/universal-editor.es.js",
      "require": "./dist/universal-editor.umd.js"
    },
    "./styles.css": "./src/ui/styles.css",
    "./dist/esm": "./dist/universal-editor.es.js",
    "./dist/umd": "./dist/universal-editor.umd.js"
  },
  "files": [
    "dist",
    "src/ui/styles.css",
    "README.md"
  ],
  "repository": {
    "type": "git",
    "url": "https://github.com/shamimSoftE/universal-editor.git",
    "directory": "packages/core"
  },
  "homepage": "https://github.com/shamimSoftE/universal-editor#readme",
  "sideEffects": [
    "*.css",
    "./src/ui/styles.css"
  ],
  "keywords": [
    "rich-text-editor",
    "prosemirror",
    "tiptap",
    "wysiwyg",
    "content-editor"
  ],
  "author": "shamimSoftE",
  "license": "MIT",
  "scripts": {
    "build": "vite build",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@tiptap/core": "^2.2.4",
    "@tiptap/extension-bubble-menu": "^2.2.4",
    "@tiptap/extension-character-count": "^2.2.4",
    "@tiptap/extension-code-block": "^2.2.4",
    "@tiptap/extension-code-block-lowlight": "^2.2.4",
    "@tiptap/extension-color": "^2.2.4",
    "@tiptap/extension-font-family": "^2.2.4",
    "@tiptap/extension-highlight": "^2.2.4",
    "@tiptap/extension-image": "^2.2.4",
    "@tiptap/extension-link": "^2.2.4",
    "@tiptap/extension-mention": "^2.2.4",
    "@tiptap/extension-subscript": "^2.2.4",
    "@tiptap/extension-superscript": "^2.2.4",
    "@tiptap/extension-table": "^2.2.4",
    "@tiptap/extension-table-cell": "^2.2.4",
    "@tiptap/extension-table-header": "^2.2.4",
    "@tiptap/extension-table-row": "^2.2.4",
    "@tiptap/extension-task-item": "^2.2.4",
    "@tiptap/extension-task-list": "^2.2.4",
    "@tiptap/extension-text-align": "^2.2.4",
    "@tiptap/extension-text-style": "^2.2.4",
    "@tiptap/extension-underline": "^2.2.4",
    "@tiptap/pm": "^2.2.4",
    "@tiptap/starter-kit": "^2.2.4",
    "@tiptap/suggestion": "^2.2.4",
    "@shamimsofte/universal-editor-utils": "^1.0.1",
    "lowlight": "^2.9.0"
  },
  "devDependencies": {
    "typescript": "^5.4.2",
    "vite": "^5.1.5"
  }
}
